     "h": [
      "name 是名字。",
      "回答你叫什麼名字。"
     ],
     "e": "What's your name? 你叫什麼名字？→ My name is ___。"
    },
    {
     "type": "choice",
     "q": "「How old are you?」最適合怎麼回答？",
     "a": "I'm ten years old.",
     "w": [
      "I'm fine.",
